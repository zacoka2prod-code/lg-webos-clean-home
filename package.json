{
  "name": "lg-webos-clean-home",
  "version": "0.0.121",
  "description": "Clean Home for LG webOS, adapted from Launch Home",
  "private": true,
  "scripts": {
    "build": "node scripts/build.js",
    "pack": "node scripts/build.js --pack",
    "verify-ipk": "node scripts/verify-ipk.js",
    "deploy": "bash scripts/deploy.sh",
    "test": "vitest run",
    "clean": "rm -rf dist",
    "version:set": "node scripts/set-version.js",
    "version": "node scripts/set-version.js && git add version.md appinfo.json voice/overlay/appinfo.json"
  },
  "devDependencies": {
    "@procot/webostv": "^1.2.6",
    "@webos-tools/cli": "^3.2.6",
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.3",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "qrcode-generator": "^2.0.4"
  },
  "engines": {
    "node": ">=24.15.0"
  },
  "overrides": {
    "brace-expansion@>=1 <2": "1.1.21",
    "brace-expansion@>=2 <3": "2.1.7",
    "brace-expansion@>=4": "5.0.12",
    "proxy-addr": "2.0.8",
    "qs": "6.16.0",
    "tmp": "0.2.6",
    "js-yaml": "4.3.2"
  }
}
